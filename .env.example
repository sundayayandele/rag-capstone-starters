# Copy to .env (never commit .env). Defaults run fully offline with no keys.
RAG_LLM=none            # none | github | anthropic
RAG_LLM_MODEL=          # optional override, e.g. openai/gpt-4.1-mini (github) or claude-haiku-4-5 (anthropic)
GITHUB_TOKEN=           # for RAG_LLM=github (GitHub Models)
ANTHROPIC_API_KEY=      # for RAG_LLM=anthropic
RAG_EMBEDDER=hash       # hash | st (needs: pip install -e ".[ml]")
RAG_RERANKER=lexical    # lexical | ce (needs: pip install -e ".[ml]")
